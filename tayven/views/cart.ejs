<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Shopping Cart</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/cart.css">
    <script src="/js/simpleParallax.min.js" type="module"></script>
    <script src="/js/parallax.js" type="module"></script>
    <script src="/js/products.js" type="module"></script>
    <script src="/js/mobile-nav.js" type="module"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=McLaren&display=swap" rel="stylesheet">
</head>
    <body>
        <nav>
            <div class="logo"><a href='/'>TM</a></div>
            <button class="mobile-open"><img src="/assets/menu_icon.png" alt="open menu"></button>
            <ul>
                <li><a href="/">HOME</a></li>
                <li><a href="/mowing">MOWING</a></li>
                <li><a href="/products">PRODUCTS</a></li>
            </ul>
            <div class="cart"><a href="/cart"><img src="/assets/cart-icon.png" alt="cart"></a></div>
        </nav>
        <main>
            <% if (cart && (Object.keys(cart.items).length !== 0)) { // if there is anything in the cart %>
                <section class="order-products">
                    <form action="/cart/update" method="POST">
                        <table>
                            <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                            </tr>
                            </thead>
                            <tbody>
                                <!--                                       Code to iterate through the cart object's items that is passed through ejs -->
    <!--                            List of products you have bought: will be changed to be filled by ejs later in roadmap-->
                                <% cart.items.forEach( (product) => { %>
                                    <tr>
                                        <td>
                                            <%= product.name %>
                                        </td>
                                        <td>
                                            $<%= product.price %>
                                        </td>
                                        <td>
                                            <input 
                                                type="number" 
                                                name="items[<%= product.sku %>]"
                                                aria-label="Quantity" 
                                                value="<%= product.quantity %>"
                                                min="0" 
                                                id="quantity-<%= product.sku %>"
                                            >
                                        </td>
                                        <td>
                                            $<%= product.price * product.quantity %>
                                        </td>
                                    </tr>
                                <% }) %>
                                <tr>
                                    <td><strong>TOTAL</strong></td>
                                    <td></td><td></td>
                                    <td>
                                        <%
                                            let total = 0
                                            cart.items.forEach((product, index) => {
                                                total += product.price * product.quantity;
                                            });
                                        %>
                                        $<%= total %>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="contact-info">
                            <%
                                let fname = cart?.contact?.fname ? cart.contact.fname : "";

                                let lname = cart?.contact?.lname ? cart.contact.lname : "";

                                let email = cart?.contact?.email ? cart.contact.email : "";

                                let phone = cart?.contact?.phone ? cart.contact.phone : "";

                                let address = cart?.contact?.address ? cart.contact.address : "";
                            %>
                            <div>
                                <label for="fname">First Name <span class="red">*</span></label>
                                <input type="text" value="<%= fname%>" name="contact[fname]" id="fname" required minlength="2" maxlength="20" pattern="[\w-' ]{2,20}" title="First name">
    
                                <label for="lname">Last Name <span class="red">*</span></label>
                                <input type="text" value="<%= lname%>" name="contact[lname]" id="lname" required minlength="2" maxlength="20" pattern="[\w-' ]{2,20}" title="Last name">
                            </div>
                            <div>
                                <label for="email">Email <span class="red">*</span></label>
                                <input type="email" value="<%= email%>" name="contact[email]" id="email" required pattern="\w+([\.\-]\w+)*@[\w\-]+(\.[\w\-]{2,8}){1,2}" title="Please submit a valid email">
    
                                <label for="phone">Phone</label>
                                <input type="text" value="<%= phone%>" name="contact[phone]" id="phone" pattern="(02[0-9][\s\-]?([0-9]{3,4}[\s\-]?[0-9]{3,4}|[0-9]{6,8}))?" title="Format like 021-389-340 or 021 323 7647">
                            </div>
    
                            <div>
                                <label for="address">Address <span class="red">*</span></label>
                                <input type="text" value="<%= address%>" name="contact[address]" id="address" required minlength="10" title="Format like 123 Place st, Sometown 5624">

                                <p>Fields marked with <span class="red">*</span> are required</p>
                            </div>
                        </div>
    
                        <div class="form-actions">
    <!--                        Submit order or update contents-->
                            <button type="submit" formaction="/cart/update" name="action" value="update" id="update">Update</button>
                            <button type="submit" formaction="/cart/order" name="action" value="order" id="submit">Place Order</button>
                        </div>
                    </form>
                </section>
            <% } else { %>
                <p id="cart-empty-message">Your cart is empty.</p>
            <% } %>
        </main>
        <footer>
            <!--        content that slides-->
            <div class="marquee-track">
                <!--            two duplicate contents, but only the first is read by screen readers for accessibility purposes-->
                <div class="marquee-content">TAYVEN McLELLAN — I make quality wooden kitchen utensils and provide reliable lawn mowing services. Contact me through: <strong><a href="mailto://<%= tayvenEmail %>" class="dark-link"><%= tayvenEmail%></a></strong> or <strong><%= tayvenPhone %></strong>. Cart icon and mobile icon from <a href="https://magnific.com" class="dark-link">Magnific</a></div>
                <div class="marquee-content" aria-hidden="true">TAYVEN McLELLAN — I make quality wooden kitchen utensils and provide reliable lawn mowing services. Contact me through: <strong><a href="mailto://<%= tayvenEmail %>" class="dark-link"><%= tayvenEmail%></a></strong> or <strong><%= tayvenPhone %></strong>. Cart icon and mobile icon from <a href="https://magnific.com" class="dark-link">Magnific</a></div>
            </div>
        </footer>
    </body>
</html>
