<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Mowing Services</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/mowing.css">
    <script src="/js/simpleParallax.min.js" type="module"></script>
    <script src="/js/parallax.js" type="module"></script>
    <script src="/js/mobile-nav.js" type="module"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=McLaren&display=swap" rel="stylesheet">
</head>
    <body>
        <nav>
            <div class="logo"><a href='/'>TM</a></div>
            <button class="mobile-open"><img src="/assets/menu_icon.png" alt="open menu"></button>
            <ul>
                <li><a href="/">HOME</a></li>
                <li><a href="/mowing">MOWING</a></li>
                <li><a href="/products">PRODUCTS</a></li>
            </ul>
            <div class="cart"><a href="/cart"><img src="/assets/cart-icon.png" alt="cart"></a></div>
        </nav>
    <header>
        <h1><span class="drop-shadow">MOWING <br>SERVICES</span></h1>
        <p id="header-message">Reliable lawn mowing throughout the South Wairarapa.</p>
        <video class="floating-video" autoplay muted>
            <source src="/assets/placeholder-video.mp4" type="video/mp4">
            Your browser does not support the video tag.
        </video>
    </header>
    <main>
        <article class="left-text">
            <h2>Get A Quote!</h2>
            <p>Easily get a quote for the cost to mow your lawn anywhere in Martinborough, Greytown, Featherston, or Carterton. Reliable and local, just fill out the form and I'll get back to you and quickly sort out a plan to keep your grass cut and clean!</p>
        </article>
        <article class="right-text" id="mowing-quotes-article">
            <h2>Get A Quote From Me</h2>
    <!--    Form -->
            <form action="/quotes" method="post">

    <!--        Customer Contact Information-->
                <div class="name">
                    <div>
                        <label for="fname">First Name: <span class="red">*</span></label>
                        <input type="text" id="fname" name="contact[fname]" required pattern="[a-zA-Z \-']{2,15}" title="Please give your first name.">
                    </div>
                    <div>
                        <label for="lname">Last Name: <span class="red">*</span></label>
                        <input type="text" id="lname" name="contact[lname]" required pattern="[a-zA-Z \-']{2,15}" title="Please give your surname (last name).">
                    </div>
                </div>
                <div class="contact">
                    <div>
                        <label for="email">Email Address: <span class="red">*</span></label>
                        <input type="email" id="email" name="contact[email]" required pattern="\w+([\.\-]\w+)*@[\w\-]+(\.[\w\-]{2,8}){1,2}" title="Give a valid email like some.thing@domain.com">
                    </div>
                    <div>
                        <label for="phone">Mobile Phone:</label>
                        <input type="text" id="phone" name="contact[phone]" pattern="(02[0-9][\s\-]?([0-9]{3,4}[\s\-]?[0-9]{3,4}|[0-9]{6,8}))?" title="Please give a valid phone number (format like 021-1234-567 or 021 1234 567)">
                    </div>
                </div>

    <!--        Grass Information -->
                <div class="grass-info">
    <!--            Caught or Uncaught -->
                    <div>
                        <label for="caught">Grass <span class="red">*</span></label>
                        <select id="caught" name="options[caught]">
                            <option value="true">Caught</option>
                            <option value="false">Uncaught</option>
                        </select>
                    </div>

    <!--                Height of Cut Grass-->
                    <div>
                        <label for="height">Height <span class="red">*</span></label>
                        <select id="height" name="options[height]">
                            <option value="high">High</option>
                            <option value="medium">Med</option>
                            <option value="low">Low</option>
                        </select>
                    </div>

    <!--                Area of Lawn-->
                    <div>
                        <label for="area">Area of Lawn <span class="red">*</span></label>
                        <select id="area" name="options[area]">
                            <option value="large">Large</option>
                            <option value="medium">Medium</option>
                            <option value="small">Small</option>
                        </select>
                    </div>
                </div>
    <!--            Final Comments -->
                <div class="comments">
                    <label for="comments">Any Further Comments?</label>
                    <textarea id="comments" name="comments"></textarea>
                    <p> Questions marked with <span class="red">*</span> are required.</p>
                </div>
                <button type="submit" class="submit">SUBMIT</button>
            </form>
        </article>
    </main>
        <footer>
            <!--        content that slides-->
            <div class="marquee-track">
                <!--            two duplicate contents, but only the first is read by screen readers for accessibility purposes-->
                <div class="marquee-content">TAYVEN McLELLAN — I make quality wooden kitchen utensils and provide reliable lawn mowing services. Contact me through: <strong><a href="mailto://<%= tayvenEmail %>" class="dark-link"><%= tayvenEmail%></a></strong> or <strong><%= tayvenPhone %></strong>. Cart icon and mobile icon from <a href="https://magnific.com" class="dark-link">Magnific</a>. Free Stock Video Footage by <a href="http://www.videezy.com/" class="dark-link">Videezy</a></div>
                <div class="marquee-content" aria-hidden="true">TAYVEN McLELLAN — I make quality wooden kitchen utensils and provide reliable lawn mowing services. Contact me through: <strong><a href="mailto://<%= tayvenEmail %>" class="dark-link"><%= tayvenEmail%></a></strong> or <strong><%= tayvenPhone %></strong>. Cart icon and mobile icon from <a href="https://magnific.com" class="dark-link">Magnific</a>. Free Stock Video Footage by <a href="http://www.videezy.com/" class="dark-link">Videezy</a></div>
            </div>
        </footer>
    </body>
</html>
