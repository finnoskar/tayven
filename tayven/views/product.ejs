<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Tayven McLellan</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/product.css">
    <script src="/js/index.js" type="module"></script>
    <script src="/js/mobile-nav.js" type="module"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=McLaren&display=swap" rel="stylesheet">
</head>
<body>
<nav>
    <div class="logo"><a href='/'>TM</a></div>
    <button class="mobile-open"><img src="/images/menu_icon.png" alt="open menu"></button>
    <ul>
        <li><a href="/">HOME</a></li>
        <li><a href="/mowing">MOWING</a></li>
        <li><a href="/products">PRODUCTS</a></li>
    </ul>
    <div class="cart"><a href="/cart"><img src="/images/cart-icon.png" alt="cart"></a></div>
</nav>
    <main id="product-main">

<!--        main product section-->

<!--        image and name-->

        <section class="product-header">
            <h1><%= name.toUpperCase() %></h1>
            <img src="/images/snow-landscape.jpg" alt="image of <%= name %>">
        </section>

<!--        product information-->
        <section class="product-info">
            <h2 id="price">Price: <span><%= price %></span></h2>
            <h2>Description</h2>
            <p><%= description %></p>
            <button>Add To Cart</button>
        </section>

    </main>
    <footer>
        <!--        content that slides-->
        <div class="marquee-track">
            <!--            three duplicate contents, but only the first is read by screen readers for accessibility purposes-->
            <div class="marquee-content">TAYVEN McLELLAN — I make quality wooden kitchen utensils and provide reliable lawn mowing services. Contact me through: <strong><a href="mailto://<%= tayvenEmail %>" class="dark-link"><%= tayvenEmail%></a></strong> or <strong><%= tayvenPhone %></strong></div>
            <div class="marquee-content" aria-hidden="true">TAYVEN McLELLAN — I make quality wooden kitchen utensils and provide reliable lawn mowing services. Contact me through: <strong><a href="mailto://<%= tayvenEmail %>" class="dark-link"><%= tayvenEmail%></a></strong> or <strong><%= tayvenPhone %></strong></div>
        </div>
    </footer>
</body>
</html>
