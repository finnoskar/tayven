<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Tayven McLellan</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/product.css">
    <script src="/js/index.js" type="module"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=McLaren&display=swap" rel="stylesheet">
</head>
<body>
    <nav>
        <div class="logo"><a href='/'>TM</a></div>
        <ul>
            <li><a href="/">HOME</a></li>
            <li><a href="/mowing">MOWING</a></li>
            <li><a href="/products">PRODUCTS</a></li>
        </ul>
        <div class="cart"><a href="/cart"><img src="/images/cart-icon.png" alt="cart"></a></div>
    </nav>

    <main id="product-main">

<!--        main product section-->

<!--        image and name-->

        <section class="product-header">
            <h2><%= name %></h2>
            <img src="/images/products/<%=name %>.jpg" alt="image of <%= name %>">
        </section>

<!--        product information-->
        <section class="product-info">
            <h2 id="price">Price: <span><%= price %></span></h2>
            <h2>Description</h2>
            <p><%= description %></p>
            <button>Add To Cart</button>
        </section>

    </main>
</body>
</html>
